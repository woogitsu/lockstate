{
  "name": "lockstate",
  "version": "0.0.51",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && node scripts/cloudflare-task.mjs build production",
    "build:staging": "pnpm typecheck && node scripts/cloudflare-task.mjs build staging",
    "preview": "vite preview",
    "preview:production": "node scripts/cloudflare-task.mjs preview production",
    "preview:staging": "node scripts/cloudflare-task.mjs preview staging",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "benchmark": "node scripts/run-benchmarks.mjs --profile full",
    "benchmark:smoke": "node scripts/run-benchmarks.mjs --profile smoke --output benchmark-results/smoke.json",
    "verify:benchmark": "pnpm benchmark:smoke && node scripts/verify-benchmark-result.mjs benchmark-results/smoke.json",
    "verify": "pnpm typecheck && pnpm test && node scripts/cloudflare-task.mjs build production",
    "verify:assets": "node tooling/validate-runtime-atlas.mjs public/assets/actors",
    "content:source-art": "node tooling/build-source-art-catalog.mjs",
    "verify:sql": "node scripts/verify-supabase-sql.mjs",
    "verify:stack": "node scripts/verify-supabase-stack.mjs",
    "verify:deployment": "node scripts/verify-cloudflare-deployment.mjs",
    "deploy": "pnpm deploy:production",
    "deploy:staging": "node scripts/cloudflare-task.mjs deploy staging",
    "deploy:production": "node scripts/cloudflare-task.mjs deploy production",
    "deploy:dry-run:staging": "node scripts/cloudflare-task.mjs dry-run staging",
    "deploy:dry-run:production": "node scripts/cloudflare-task.mjs dry-run production"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "phaser": "4.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
