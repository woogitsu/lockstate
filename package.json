    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "phaser": "4.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
