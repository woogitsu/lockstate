@@ -133,3 +133,17 @@ new MutationObserver(()=>{if(game.classList.contains('panel-hidden')){layout.rig
 applyLayout();
 const previousResearchChapter=researchChapter;
 researchChapter=()=>`<section class="guide-card"><span class="eyebrow">ITERACJA 03 / PANELE</span><h2>Ustaw przestrzeń do pracy.</h2><p>Strzałki przy krawędziach zwijają lewą nawigację, prawy inspektor i górne metryki. Przeciągaj krawędzie paneli, aby zmienić rozmiar; dwuklik przywraca rozmiar domyślny. Na telefonie zmieniasz wysokość dolnego panelu.</p><p>Menu <b>Układ</b> zawiera suwak, przywracanie ustawień oraz tryb „Tylko mapa”. Preferencje są zapamiętywane lokalnie. Uchwyt rozmiaru obsługuje strzałki, Home/End i Enter; Shift zwiększa krok.</p><p>Inspiracje: <a href="https://www.w3.org/WAI/ARIA/apg/patterns/windowsplitter/" target="_blank" rel="noreferrer">W3C — Window Splitter</a> i <a href="https://code.visualstudio.com/docs/configure/custom-layout" target="_blank" rel="noreferrer">VS Code — Custom Layout</a>. Zakres weryfikacji: składnia i kontrola limitów rozmiaru, bez browser QA.</p></section>`+previousResearchChapter();
+
+// Theme is a device preference; it never changes the simulation clock.
+const systemNight=matchMedia('(prefers-color-scheme: dark)');
+let themeChoice='system';
+try{const saved=localStorage.getItem('lockstate-theme-v1');if(['light','dark','system'].includes(saved))themeChoice=saved}catch{}
+const themeButton=document.createElement('button');themeButton.className='icon-btn theme-toggle';themeButton.dataset.action='toggle-theme';$('.top-actions').append(themeButton);
+function applyTheme(save=false){const dark=themeChoice==='dark'||(themeChoice==='system'&&systemNight.matches);document.documentElement.dataset.theme=dark?'dark':'light';themeButton.textContent=dark?'☀':'☾';themeButton.title=dark?'Włącz tryb dzienny':'Włącz tryb nocny';themeButton.setAttribute('aria-label',themeButton.title);themeButton.setAttribute('aria-pressed',String(dark));if(save)try{localStorage.setItem('lockstate-theme-v1',themeChoice)}catch{};}
+actions['toggle-theme']=()=>{themeChoice=document.documentElement.dataset.theme==='dark'?'light':'dark';applyTheme(true)};
+const originalSettings=actions.settings;
+actions.settings=()=>{originalSettings();const block=document.createElement('label');block.className='form-row';block.innerHTML=`Wygląd<select id="theme-choice"><option value="system">Zgodnie z urządzeniem</option><option value="light">Tryb dzienny</option><option value="dark">Tryb nocny</option></select>`;$('#modal-content').insertBefore(block,$('#modal-content').children[1]);$('#theme-choice').value=themeChoice;};
+document.addEventListener('change',e=>{if(e.target.id==='theme-choice'){themeChoice=e.target.value;applyTheme(true)}});
+systemNight.addEventListener('change',()=>{if(themeChoice==='system')applyTheme()});
+addEventListener('storage',e=>{if(e.key==='lockstate-theme-v1'){themeChoice=['light','dark','system'].includes(e.newValue)?e.newValue:'system';applyTheme()}});
+applyTheme();
