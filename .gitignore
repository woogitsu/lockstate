# No trailing slash. `node_modules/` matches only a directory, so a
# *symlink* named node_modules was a file git would happily commit -- and
# three pull requests did, breaking their own CI before any code ran.
node_modules
dist/
.dev.vars*
.env
.env.*
!.env.example
.wrangler/
coverage/
playwright-report/
test-results/
benchmark-results/
*.tsbuildinfo
.DS_Store
Thumbs.db
*.log
supabase/.temp/
assets/intermediate/
assets/runtime/
# Blender imports tooling/blender/pipeline_common.py, which makes CPython write
# bytecode next to it.
tooling/blender/__pycache__/
# Agent worktrees. `.claude/` itself is tracked (hooks, settings), so a
# worktree created under it shows up as untracked content in a tree the
# repository's own clean-tree gate reads -- and untracked content sitting in a
# tracked directory is how the node_modules symlink above got committed.
.claude/worktrees/
